{
  "name": "chatgpt-toolbox",
  "private": true,
  "description": "Tampermonkey userscript build for ChatGPT toolbox",
  "scripts": {
    "build": "node scripts/check-encoding.mjs && node scripts/check-toolbox-header-status-no-free-vars.mjs && node build.userjs.mjs && node --check dist/client.user.js && node scripts/check-dist-no-header-free-state.mjs",
    "watch": "node scripts/check-encoding.mjs && node build.userjs.mjs --watch",
    "check:encoding": "node scripts/check-encoding.mjs",
    "fix:encoding": "node scripts/fix-encoding.mjs",
    "check:dist": "node --check dist/client.user.js",
    "check:upload-persist-db": "node scripts/check-upload-persist-db-no-free-vars.mjs",
    "check:upload-file-source": "node scripts/check-upload-file-source-no-free-vars.mjs",
    "check:upload-queue-store": "node scripts/check-upload-queue-store-no-free-vars.mjs",
    "check:toolbox-header-status": "node scripts/check-toolbox-header-status-no-free-vars.mjs",
    "check:dist-header-state": "node scripts/check-dist-no-header-free-state.mjs",
    "check:toolbox-shell-state": "node scripts/check-toolbox-shell-no-free-state.mjs",
    "check:refactor-duplicates": "node scripts/check-refactor-duplicates.mjs",
    "check:authority-state": "node scripts/check-authority-state-boundaries.mjs",
    "verify:toolbox-state": "npm run check:authority-state && npm run build",
    "check:no-chat-message-cache": "node scripts/check-no-chat-message-cache.mjs",
    "audit:src-structure": "node scripts/audit-source-structure.mjs",
    "archive:chat-message-cache": "node scripts/refactor-archive-chat-message-cache.mjs",
    "verify:autoqueue-display-state": "node scripts/refactor-split-autoqueue-display-state.mjs --verify-only",
    "check": "npm run check:refactor-duplicates && npm run check:no-chat-message-cache && npm run check:authority-state",
    "rebuild": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3"
  }
}
